{
  "name": "nutrasa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../eslint.config.js src tests --max-warnings=0",
    "test": "node --test tests/*.test.ts",
    "migrate": "node src/migrations/cli.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/migrations.integration.ts",
    "test:integration:identity": "node --test --test-concurrency=1 tests/integration/identity.integration.ts",
    "test:integration:food-sources": "node --test --test-concurrency=1 tests/integration/food-sources.integration.ts",
    "test:integration:food-catalog": "node --test --test-concurrency=1 tests/integration/food-catalog.integration.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "typescript": "6.0.3"
  }
}
