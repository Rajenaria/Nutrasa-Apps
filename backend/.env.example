# M03-02B: template koneksi lokal; server belum memuat .env atau memakai PostgreSQL.
# Isi hanya backend/.env yang diabaikan Git, dengan credential role yang sah.
# REPLACE_LOCALLY adalah placeholder, bukan password yang tersedia.
# Kedua URL adalah rahasia backend; jangan gunakan EXPO_PUBLIC_* atau mencetaknya.

# Koneksi runtime aplikasi: role tanpa hak DDL.
DATABASE_URL=postgresql://nutrasa_dev_app:REPLACE_LOCALLY@127.0.0.1:5432/nutrasa_dev

# Koneksi migrator: role terpisah dengan hak DDL pada database development saja.
# Belum ada script migrasi aktif; desain checksum database masih OPEN.
MIGRATION_DATABASE_URL=postgresql://nutrasa_dev_migrator:REPLACE_LOCALLY@127.0.0.1:5432/nutrasa_dev

# Database test yang direncanakan: nutrasa_test, dengan role test terpisah.
# Template ini tidak membuat database/role dan tidak membuktikan koneksi berhasil.
